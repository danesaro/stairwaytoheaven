---
import { Image } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import Icon from '../components/Icon.astro';
import PageIntro from '../components/PageIntro.astro';
import ConsultationCTA from '../components/ConsultationCTA.astro';
import workshop from '../assets/img/services/servicios-1.webp';
import { services } from '../data/services';
import { whatsappLink } from '../data/site';
---

<MainLayout
  title="Servicios"
  description="Fabricación e instalación de gradas prefabricadas en Cali. Mantenimiento, reparación y remodelación de escaleras, asesoría y pasamanos."
  path="/servicios"
>
  <main id="main" class="editorial-interior">
    <PageIntro
      eyebrow="Prefabricadas · Mantenimiento · Remodelación"
      title="Construir, cuidar y renovar."
      description="Nos dedicamos a las gradas prefabricadas y a conservar y transformar escaleras existentes. Encuentra el servicio que necesitas para tu obra o tu hogar."
    />
    <section class="editorial-shell services-editorial-layout" aria-label="Nuestros servicios">
      <figure class="services-editorial-photo">
        <Image
          src={workshop}
          alt="Trabajo de acabado durante la instalación de una escalera caracol"
          width={800}
          widths={[400, 600, 800]}
          sizes="(min-width: 900px) 35vw, calc(100vw - 40px)"
          loading="lazy"
        />
        <figcaption>El oficio está en cada detalle.</figcaption>
      </figure>
      <div class="services-editorial-list">
        {services.map((service, index) => (
          <article id={service.href.split('#')[1]} class="service-editorial">
            <span class="solution-number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h2>{service.title}</h2>
              <p>{service.description}</p>
              <a
                class="editorial-text-link"
                href={whatsappLink(`Hola, quisiera consultar sobre ${service.title.toLowerCase()}.`)}
                target="_blank"
                rel="noopener noreferrer"
              >
                Consultar este servicio <Icon name="arrow-up-right" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
    <ConsultationCTA title="Empecemos por lo que necesitas." />
  </main>
</MainLayout>
