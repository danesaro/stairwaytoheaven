---
import { Image } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import Icon from '../components/Icon.astro';
import PageIntro from '../components/PageIntro.astro';
import ConsultationCTA from '../components/ConsultationCTA.astro';
import workshop from '../assets/img/services/servicios-1.webp';
import { site } from '../data/site';
---

<MainLayout
  title="Acerca de nosotros"
  description="Gradas & Gradas nació en Cali en 2011. Nos especializamos en gradas prefabricadas, mantenimiento, reparación y remodelación de escaleras."
  path="/acerca-de-nosotros"
>
  <main id="main" class="editorial-interior">
    <PageIntro
      eyebrow={`Un oficio · Desde ${site.founded}`}
      title="De nuestras manos a tu hogar."
      description="Somos Gradas & Gradas. Nacimos en Cali y nos especializamos en gradas prefabricadas. También realizamos mantenimiento y remodelación de escaleras existentes."
    />
    <section class="editorial-shell about-editorial-layout" aria-labelledby="history-title">
      <figure class="home-story-photo">
        <Image
          src={workshop}
          alt="Trabajo de acabado de una escalera caracol"
          width={900}
          widths={[400, 650, 900]}
          sizes="(min-width: 900px) 45vw, calc(100vw - 40px)"
          loading="lazy"
        />
        <figcaption>El trabajo detrás de cada escalera.</figcaption>
      </figure>
      <div class="about-editorial-copy">
        <p class="editorial-eyebrow">Nuestra historia</p>
        <h2 id="history-title">Escaleras para vivir tus espacios.</h2>
        <p>
          Desde 2011, trabajamos en gradas y escaleras para viviendas y proyectos. Nuestra especialidad es la
          fabricación e instalación de gradas prefabricadas, con opciones para interiores y exteriores.
        </p>
        <p>
          Nuestro trabajo también está en las escaleras que ya forman parte de tu hogar. Realizamos
          mantenimiento y reparación para atender su desgaste, y remodelación para renovar su diseño y
          acabados. También puedes consultarnos por pasamanos y barandillas.
        </p>
        <p>
          Estamos en Cali. Si tu proyecto está en otro municipio, cuéntanos dónde sería para consultar la
          cobertura.
        </p>
        <a href="/galeria" class="editorial-text-link">
          Explora nuestros trabajos <Icon name="arrow-up-right" />
        </a>
        <a
          href="https://www.youtube.com/watch?v=iCLiiOoK0JM"
          class="editorial-text-link glightbox about-video"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="play-circle" /> Ver video de Gradas &amp; Gradas
        </a>
      </div>
    </section>
    <ConsultationCTA />
  </main>
</MainLayout>
