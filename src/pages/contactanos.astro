---
import MainLayout from '../layouts/MainLayout.astro';
import Icon from '../components/Icon.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactForm from '../components/ContactForm.astro';
import { fullAddress, site } from '../data/site';
const query = encodeURIComponent(`${site.name} ${fullAddress}`);
const mapLink = `https://www.google.com/maps/search/?api=1&query=${query}`;
---

<MainLayout
  title="Contáctanos"
  description="Consulta gradas prefabricadas, mantenimiento o remodelación de escaleras en Cali. Cotiza con Gradas & Gradas por WhatsApp o déjanos un mensaje."
  path="/contactanos"
>
  <main id="main" class="editorial-interior">
    <PageIntro
      eyebrow="Tu proyecto empieza aquí"
      title="Cuéntanos qué quieres mejorar."
      description="Gradas prefabricadas para tu obra, mantenimiento o remodelación de tu escalera actual. Escríbenos y conversemos sobre lo que necesitas."
    />
    <section class="editorial-shell contact-editorial-layout" aria-label="Iniciar una consulta">
      <div class="home-contact-copy">
        <a class="editorial-button" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" /> Cotizar por WhatsApp
        </a>
        <a class="editorial-text-link contact-call" href={`tel:${site.phoneHref}`}>
          Llamar al {site.phone}
        </a>
        <div class="home-contact-guide">
          <h2>Para empezar, puedes compartir:</h2>
          <ul>
            <li>Qué necesitas y dónde sería la instalación.</li>
            <li>Una fotografía del espacio o de tu escalera actual.</li>
            <li>Medidas aproximadas, si las tienes.</li>
          </ul>
          <p>No necesitas tener todos los detalles resueltos.</p>
        </div>
        <a class="editorial-text-link contact-email" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </div>
      <div class="home-contact-form-panel">
        <h2>¿Prefieres dejarnos un mensaje?</h2>
        <p>Completa estos datos y nos pondremos en contacto contigo.</p>
        <ContactForm idPrefix="contact" />
      </div>
    </section>
    <section class="contact-location editorial-section">
      <div class="editorial-shell contact-location-layout">
        <div>
          <p class="editorial-eyebrow">Encuéntranos en Cali</p>
          <h2>Nuestro punto de encuentro.</h2>
          <address>{fullAddress}</address>
          <p>
            Lunes a viernes: 8:00 a. m.–6:00 p. m.
            <br />
            Sábados: 8:00 a. m.–1:00 p. m.
          </p>
          <a class="editorial-text-link" href={mapLink} target="_blank" rel="noopener noreferrer">
            Ver en Google Maps <Icon name="arrow-up-right" />
          </a>
        </div>
        <iframe
          src={`https://www.google.com/maps?q=${query}&output=embed`}
          title={`Ubicación de ${site.name} en Cali`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        />
      </div>
    </section>
  </main>
</MainLayout>
