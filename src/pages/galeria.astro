---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="TÍTULO DE LA PÁGINA">
    <!-- ======= Breadcrumbs ======= -->
    <div class="breadcrumbs d-flex align-items-center" style="background-image: url('assets/img/breadcrumbs-bg.jpg');">
        <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">
  
          <h2>Galería</h2>
          <ol>
            <li><a href="/inicio">Inicio</a></li>
            <li>Galería</li>
          </ol>
  
        </div>
      </div><!-- End Breadcrumbs -->
  
      <!-- ======= Gallery section ======= -->
      <section id="projects" class="projects">
        <div class="container" data-aos="fade-up">
  
          <div class="section-header">
            <h2>Galería</h2>
            <p>Explora nuestra galería de proyectos y descubre la calidad y el estilo que caracterizan nuestro trabajo.
            </p>
          </div>
  
          <div class="portfolio-isotope" data-portfolio-filter="*" data-portfolio-layout="masonry"
            data-portfolio-sort="original-order">
  
            <ul class="portfolio-flters" data-aos="fade-up" data-aos-delay="100">
              <li data-filter="*" class="filter-active">Todo</li>
              <li data-filter=".filter-libres">Gradas Libres</li>
              <li data-filter=".filter-tapadas">Gradas Tapadas</li>
              <li data-filter=".filter-mixtas">Gradas mixtas</li>
              <li data-filter=".filter-otros">Otros</li>
            </ul><!-- End Projects Filters -->
  
            <div class="row gy-4 portfolio-container" data-aos="fade-up" data-aos-delay="200">
  
              <div class="col-lg-4 col-md-6 portfolio-item filter-libres">
                <div class="portfolio-content h-100">
                  <img src="assets/img/projects/GradaLibre-1.webp" class="img-fluid" alt="">
                  <div class="portfolio-info">
                    <h4>Gradas libres</h4>
                    <p>Grada con pasos libres</p>
                    <a href="assets/img/projects/GradaLibre-1.webp" title="Grada libre"
                      data-gallery="portfolio-gallery-libres" class="glightbox preview-link"><i
                        class="bi bi-zoom-in"></i></a>
                    <a href="project-details.html" title="Detalles" class="details-link"><i
                        class="bi bi-link-45deg"></i></a>
                  </div>
                </div>
              </div><!-- End Projects Item -->
  
              <div class="col-lg-4 col-md-6 portfolio-item filter-tapadas">
                <div class="portfolio-content h-100">
                  <img src="assets/img/projects/GradaTapada-1.webp" class="img-fluid" alt="">
                  <div class="portfolio-info">
                    <h4>Gradas tapadas</h4>
                    <p>Grada con pasos tapados</p>
                    <a href="assets/img/projects/GradaTapada-1.webp" title="Grada tapada"
                      data-gallery="portfolio-gallery-tapada" class="glightbox preview-link"><i
                        class="bi bi-zoom-in"></i></a>
                    <a href="project-details.html" title="Detalles" class="details-link"><i
                        class="bi bi-link-45deg"></i></a>
                  </div>
                </div>
              </div><!-- End Projects Item -->
  
              <div class="col-lg-4 col-md-6 portfolio-item filter-otros">
                <div class="portfolio-content h-100">
                  <img src="assets/img/projects/GradaFish-1.webp" class="img-fluid" alt="">
                  <div class="portfolio-info">
                    <h4>Otros</h4>
                    <p>Grada espina de pescado interior</p>
                    <a href="assets/img/projects/GradaFish-1.webp" title="Grada espina de pescado"
                      data-gallery="portfolio-gallery-otros" class="glightbox preview-link"><i
                        class="bi bi-zoom-in"></i></a>
