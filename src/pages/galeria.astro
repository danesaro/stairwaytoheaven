---
import MainLayout from '../layouts/MainLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ConsultationCTA from '../components/ConsultationCTA.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import ProjectViewer from '../components/ProjectViewer.astro';
---

<MainLayout
  title="Proyectos"
  description="Fotografías de escaleras y gradas realizadas por Gradas & Gradas: pasos libres, pasos tapados y otras soluciones para tu espacio."
  path="/galeria"
>
  <main id="main" class="editorial-interior">
    <PageIntro
      eyebrow="Nuestro trabajo · Cali"
      title="Distintas formas de subir."
      description="Explora nuestras escaleras, sus materiales y sus detalles. Una selección de fotografías de trabajos reales para imaginar lo que tu espacio puede llegar a ser."
    />
    <section
      id="proyectos"
      class="editorial-gallery editorial-shell"
      aria-label="Fotografías de nuestros trabajos"
    >
      <PortfolioGrid />
      <p class="gallery-note">
        Las fotografías muestran distintas vistas y soluciones; no representan necesariamente obras
        diferentes.
      </p>
    </section>
    <ConsultationCTA title="¿Buscas una solución similar?" />
  </main>
  <ProjectViewer />
</MainLayout>
