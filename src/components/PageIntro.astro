---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}
const { eyebrow, title, description } = Astro.props;
---

<header class="editorial-page-intro editorial-shell">
  <p class="editorial-eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="editorial-page-description">{description}</p>
</header>
