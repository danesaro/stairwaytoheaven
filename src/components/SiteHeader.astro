---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { navLinks, site } from '../data/site';
import logo from '../assets/img/logos/rounded_profile_pic.png';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath === href);
---

<header id="header" class="header d-flex align-items-center">
  <div class="editorial-shell d-flex align-items-center justify-content-between">
    <a href="/" class="logo d-flex align-items-center" aria-label={`${site.name} — ir al inicio`}>
      <Image
        src={logo}
        alt=""
        width={44}
        height={44}
        widths={[44, 88]}
        sizes="44px"
        format="webp"
        loading="eager"
        decoding="async"
      />
      <span class="logo-text">
        {site.shortName}
        <span class="logo-dot">.</span>
      </span>
    </a>

    <button
      type="button"
      class="mobile-nav-toggle"
      aria-controls="navbar"
      aria-expanded="false"
      aria-label="Abrir menú de navegación"
    >
      <Icon name="list" class="menu-open" />
      <Icon name="x" class="menu-close d-none" />
    </button>

    <nav id="navbar" class="navbar" aria-label="Navegación principal">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class={isActive(link.href) ? 'active' : ''}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li class="nav-quote">
          <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="editorial-button">
            <Icon name="whatsapp" /> Cotizar por WhatsApp
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.mobile-nav-toggle');
  const navbar = document.getElementById('navbar');

  if (toggle && navbar) {
    const iconOpen = toggle.querySelector<SVGElement>('.menu-open');
    const iconClose = toggle.querySelector<SVGElement>('.menu-close');

    const mobile = window.matchMedia('(max-width: 1279px)');
    const setOpen = (open: boolean) => {
      document.body.classList.toggle('mobile-nav-active', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      iconOpen?.classList.toggle('d-none', open);
      iconClose?.classList.toggle('d-none', !open);
      navbar.inert = mobile.matches && !open;
    };

    setOpen(false);

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
      if (open) {
        // Retirar inert y hacer visible el panel antes de enfocar su primer enlace.
        window.setTimeout(
          () => {
            if (toggle.getAttribute('aria-expanded') === 'true') {
              navbar.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
            }
          },
          window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 32 : 240,
        );
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
      if (event.key === 'Tab' && toggle.getAttribute('aria-expanded') === 'true') {
        const items = [toggle, ...navbar.querySelectorAll<HTMLAnchorElement>('a')];
        const first = items[0];
        const last = items.at(-1);
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    navbar.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (window.matchMedia('(max-width: 1279px)').matches) setOpen(false);
      });
    });

    mobile.addEventListener('change', () => setOpen(false));
  }
</script>

<style is:global>
  /* Cabecera en flujo: reserva espacio también en móviles de poca altura. */
  .editorial-site .header {
    z-index: 997;
    position: relative;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
    background: var(--surface-base);
  }
  .header .logo {
    gap: 4px;
  }
  .editorial-site .header .logo img {
    width: 44px;
    max-height: 44px;
    margin-right: 4px;
  }
  .editorial-site .logo-text {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.055em;
    color: var(--ink);
    margin-left: 6px;
    line-height: 1;
  }
  .editorial-site .logo-dot {
    color: var(--ink);
  }
  .editorial-site .mobile-nav-toggle {
    background: none;
    border: 0;
    padding: 0.25rem;
    border-radius: 2px;
    font-size: 2rem;
    line-height: 1;
    width: 44px;
    height: 44px;
    color: var(--ink);
  }
  .editorial-site .mobile-nav-toggle:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .navbar ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .navbar a {
    display: flex;
    align-items: center;
  }
  .navbar a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .editorial-site .navbar .editorial-button .icon {
    font-size: 18px;
    margin: 0;
  }
  @media (min-width: 1280px) {
    .mobile-nav-toggle {
      display: none;
    }
    .editorial-site .navbar ul {
      display: flex;
      align-items: center;
      gap: 30px;
    }
    .editorial-site .navbar a {
      min-height: 44px;
      padding: 10px 0;
      color: var(--ink);
      font: 500 1rem/1.4 var(--font-body);
      text-transform: none;
    }
    .editorial-site .navbar a:hover {
      text-decoration: underline;
      text-underline-offset: 5px;
    }
    .editorial-site .navbar .editorial-button {
      padding: 12px 18px;
      gap: 8px;
      min-height: 48px;
      font-weight: 600;
      text-decoration: none;
    }
  }
  @media (max-width: 1279px) {
    .editorial-site .navbar {
      position: fixed;
      top: 0;
      bottom: 0;
      width: 100%;
      max-width: 400px;
      z-index: 9997;
      transition: transform 240ms ease-out;
      right: 0;
      transform: translateX(100%);
      visibility: hidden;
    }
    .mobile-nav-active {
      overflow: hidden;
    }
    .editorial-site.mobile-nav-active .navbar {
      visibility: visible;
      transform: translateX(0);
    }
    .editorial-site .navbar ul {
      position: absolute;
      inset: 0;
      overflow-y: auto;
      background: var(--surface-base);
      padding: 100px 24px 24px;
    }
    .editorial-site .navbar a {
      color: var(--ink);
      font: 500 1.25rem/1.4 var(--font-body);
      text-transform: none;
      min-height: 52px;
      padding: 14px 12px;
    }
    .editorial-site .navbar a:hover,
    .editorial-site .navbar a:focus {
      text-decoration: underline;
      text-underline-offset: 5px;
    }
    .editorial-site .navbar .nav-quote {
      margin-top: 24px;
    }
    .editorial-site .navbar .editorial-button {
      font-size: 1rem;
      padding: 14px 18px;
    }
    .editorial-site .mobile-nav-toggle {
      position: relative;
      z-index: 9999;
    }
    .editorial-site.mobile-nav-active .mobile-nav-toggle {
      position: fixed;
      right: 24px;
      top: 26px;
    }
  }
  @media (max-width: 599px) {
    .editorial-site .header {
      padding-block: 16px;
    }
    .editorial-site .header .logo img {
      width: 36px;
      height: 36px;
    }
    .editorial-site .logo-text {
      font-size: 19px;
    }
    .editorial-site.mobile-nav-active .mobile-nav-toggle {
      top: 16px;
      right: 20px;
    }
  }
</style>
