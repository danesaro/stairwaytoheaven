---
import PortfolioCard from './PortfolioCard.astro';
import { projectFilters, projects, type Project } from '../data/projects';

interface Props {
  items?: Project[];
  limit?: number;
}

const { items = projects, limit } = Astro.props;
const visible = typeof limit === 'number' ? items.slice(0, limit) : items;

// Con limit se muestran solo las primeras N; el filtro se oculta porque
// pertenecerían a categorías que no están en la selección.
const showFilters = typeof limit !== 'number' && visible.length === items.length;
---

<div class="project-gallery">
  {showFilters && (
    <ul class="gallery-filters" aria-label="Filtrar fotografías por tipo de escalera">
      {projectFilters.map((filter, index) => (
        <li class={index === 0 ? 'filter-active' : undefined}>
          <button type="button" data-filter={filter.filter} aria-pressed={index === 0}>
            {filter.label}
          </button>
        </li>
      ))}
    </ul>
  )}

  <div class="gallery-grid">
    {visible.map((project, index) => (
      <PortfolioCard project={project} priority={index === 0} />
    ))}
  </div>
</div>

<style is:global>
  .gallery-filters button {
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    padding: 8px 4px;
    cursor: pointer;
  }

  .gallery-filters button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .editorial-gallery .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 0 0 36px;
    list-style: none;
    text-align: left;
  }
  .editorial-gallery .gallery-filters li {
    margin: 0;
    font: 500 1rem/1.4 var(--font-body);
  }
  .editorial-gallery .gallery-filters button {
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--line);
    color: var(--ink);
  }
  .editorial-gallery .gallery-filters .filter-active button {
    color: var(--ink);
    background: var(--accent);
    border-color: var(--accent);
  }
  .editorial-gallery .gallery-filters button:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .editorial-gallery .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .editorial-gallery .gallery-item {
    min-width: 0;
  }
  .editorial-gallery .gallery-item[hidden] {
    display: none;
  }
  @media (max-width: 991px) {
    .editorial-gallery .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .editorial-gallery .gallery-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
