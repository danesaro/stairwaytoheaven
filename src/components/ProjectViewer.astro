---
import Icon from './Icon.astro';
import { getImage } from 'astro:assets';
import { projects } from '../data/projects';
const initialImage = await getImage({ src: projects[0].image, width: 1600, quality: 78, format: 'webp' });
---

<dialog class="project-viewer" aria-labelledby="viewer-title" aria-describedby="viewer-description">
  <div class="viewer-layout">
    <header class="viewer-toolbar">
      <p>
        Fotografías de nuestros trabajos <span data-viewer-count></span>
      </p>
      <div class="viewer-actions">
        <button type="button" data-viewer-zoom aria-pressed="false" disabled>
          <Icon name="zoom-in" /> <span>Acercar</span>
        </button>
        <button type="button" data-viewer-close aria-label="Cerrar imagen ampliada">
          <Icon name="x" />
        </button>
      </div>
    </header>
    <div
      class="viewer-stage"
      tabindex="0"
      role="region"
      aria-label="Fotografía ampliada. Con zoom, desplázate para revisar los detalles."
    >
      <div class="viewer-image-space">
        <img data-viewer-image alt="" width="1600" height="1600" draggable="false" />
      </div>
      <p class="viewer-status" role="status" aria-live="polite"></p>
    </div>
    <footer class="viewer-footer">
      <div class="viewer-caption" aria-live="polite" aria-atomic="true">
        <h2 id="viewer-title"></h2>
        <p id="viewer-description"></p>
      </div>
      <div class="viewer-navigation">
        <button type="button" data-viewer-previous aria-label="Fotografía anterior">
          ←
        </button>
        <button type="button" data-viewer-next aria-label="Fotografía siguiente">
          →
        </button>
        <a data-viewer-original href={initialImage.src} target="_blank" rel="noopener noreferrer">
          Abrir imagen <Icon name="arrow-up-right" />
        </a>
      </div>
    </footer>
    <p class="viewer-help">
      Usa las flechas o desliza para cambiar de foto. Acerca la imagen para ver detalles.
    </p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.project-viewer');
  let viewer: Promise<ReturnType<(typeof import('../scripts/project-viewer'))['createProjectViewer']>>;
  if (dialog && typeof dialog.showModal === 'function') {
    document.querySelectorAll<HTMLAnchorElement>('[data-project-image]').forEach((link) => {
      link.addEventListener('click', async (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        try {
          viewer ??= import('../scripts/project-viewer').then(({ createProjectViewer }) =>
            createProjectViewer(dialog),
          );
          (await viewer).open(link);
        } catch {
          window.location.assign(link.href);
        }
      });
    });
  }
</script>

<style>
  .project-viewer {
    width: min(1280px, calc(100% - 48px));
    height: min(940px, calc(100dvh - 48px));
    max-width: none;
    max-height: none;
    padding: 0;
    border: 1px solid #615d52;
    background: #282722;
    color: #fffcf6;
    overflow: hidden;
  }
  .project-viewer::backdrop {
    background: rgb(20 19 16 / 88%);
  }
  .viewer-layout {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    height: 100%;
  }
  .viewer-toolbar,
  .viewer-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 16px 24px;
  }
  .viewer-toolbar {
    flex-wrap: wrap;
    border-bottom: 1px solid #615d52;
  }
  .viewer-toolbar p {
    flex: 1 1 160px;
    min-width: 0;
    margin: 0;
    font-size: 0.9rem;
    color: #cbc5b9;
  }
  [data-viewer-count] {
    display: inline-block;
    margin-left: 16px;
    color: #fffcf6;
    white-space: nowrap;
  }
  .viewer-actions,
  .viewer-navigation {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .viewer-navigation {
    flex-wrap: wrap;
  }
  .project-viewer button,
  .project-viewer a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 48px;
    min-height: 48px;
    border: 1px solid #8d867a;
    background: transparent;
    color: #fffcf6;
    font: 600 1rem/1.3 var(--font-body);
    padding: 10px 14px;
    cursor: pointer;
  }
  .project-viewer button:hover:not(:disabled),
  .project-viewer a:hover {
    background: #454137;
  }
  .project-viewer button[aria-pressed='true'] {
    background: #feb900;
    color: #282722;
    border-color: #feb900;
  }
  .project-viewer button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .project-viewer :focus-visible {
    outline: 2px solid #feb900;
    outline-offset: -4px;
  }
  [data-viewer-close] {
    font-size: 1.5rem !important;
  }
  .viewer-stage {
    position: relative;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    scrollbar-color: #8d867a #282722;
    touch-action: pan-y;
  }
  .viewer-stage[data-zoomed] {
    touch-action: pan-x pan-y pinch-zoom;
  }
  .viewer-image-space {
    display: grid;
    place-items: center;
    min-width: 100%;
    min-height: 100%;
    width: max-content;
  }
  .viewer-stage img {
    display: block;
    object-fit: contain;
    visibility: hidden;
  }
  .viewer-stage[data-ready] img {
    visibility: visible;
    cursor: zoom-in;
  }
  .viewer-stage[data-zoomed] img {
    cursor: grab;
  }
  .viewer-stage[data-dragging] img {
    cursor: grabbing;
  }
  .viewer-status {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    margin: 0;
    padding: 24px;
    text-align: center;
    color: #cbc5b9;
    pointer-events: none;
  }
  .viewer-footer {
    border-top: 1px solid #615d52;
  }
  .viewer-caption {
    min-width: 0;
  }
  .viewer-caption h2 {
    margin: 0;
    font-size: 1.3rem;
    line-height: 1.2;
    font-weight: 500;
  }
  .viewer-caption p {
    margin: 8px 0 0;
    color: #cbc5b9;
    font-size: 1rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .viewer-navigation button {
    font-size: 1.3rem;
  }
  .viewer-navigation a {
    font-size: 0.9rem;
  }
  .viewer-help {
    margin: 0;
    padding: 0 24px 16px;
    font-size: 0.8rem;
    color: #cbc5b9;
  }
  @media (max-width: 699px) {
    .project-viewer {
      width: 100%;
      height: 100dvh;
      border: 0;
      margin: 0;
      overflow-y: auto;
    }
    .viewer-layout {
      grid-template-rows: auto minmax(80px, 1fr) auto auto;
    }
    .viewer-toolbar,
    .viewer-footer {
      padding: 12px 16px;
      gap: 12px;
    }
    .viewer-toolbar p {
      font-size: 0.8rem;
    }
    [data-viewer-count] {
      display: block;
      margin: 4px 0 0;
    }
    .viewer-footer {
      flex-direction: column;
      align-items: stretch;
    }
    .viewer-navigation {
      justify-content: flex-end;
    }
    .viewer-navigation a {
      margin-left: auto;
    }
    .viewer-help {
      padding: 0 16px 12px;
      font-size: 0.75rem;
    }
    .viewer-caption h2 {
      font-size: 1.1rem;
    }
    .viewer-caption p {
      font-size: 0.9rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .project-viewer[open] {
      animation: viewer-enter 220ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    @keyframes viewer-enter {
      from {
        opacity: 0;
        transform: translateY(10px) scale(0.985);
      }
    }
  }
</style>
