---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Seo from '../components/Seo.astro';
import { site } from '../data/site';

import '../styles/base.css';
import '../styles/editorial.css';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica relativa, p. ej. `/servicios`. */
  path?: string;
  ogImage?: string;
}

const { title, description, path = Astro.url.pathname, ogImage } = Astro.props;
const fontsUrl =
  'https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap';
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={site.themeColor} />

    <title>{title === site.name ? `${site.name} | Gradas prefabricadas en Cali` : `${title} | ${site.name}`}</title>
    <meta name="description" content={description} />

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsUrl} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={fontsUrl} />
    </noscript>

    <Seo title={title} description={description} path={path} image={ogImage} />
  </head>

  <body id="top" class="editorial-site">
    <a href="#main" class="skip-link">
      Saltar al contenido principal
    </a>

    <SiteHeader />

    <slot />

    <SiteFooter />

    <script>
      import { initPage } from '../scripts/page';

      // Mantener la navegación nativa: cada documento inicializa sus controles.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPage, { once: true });
      } else {
        initPage();
      }
    </script>
  </body>
</html>
